{
  "name": "valorant-community",
  "author": "Nicolás Garzón (nicoo.dev)",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @valorant/api dev",
    "build": "pnpm --filter @valorant/api build",
    "start": "pnpm --filter @valorant/api start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --filter @valorant/api typecheck",
    "test": "pnpm --filter @valorant/api test",
    "test:e2e": "pnpm --filter @valorant/api test:e2e",
    "db:generate": "pnpm --filter @valorant/api db:generate",
    "db:validate": "pnpm --filter @valorant/api db:validate",
    "db:migrate": "pnpm --filter @valorant/api db:migrate",
    "db:deploy": "pnpm --filter @valorant/api db:deploy",
    "catalog:sync": "pnpm --filter @valorant/api catalog:sync"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
